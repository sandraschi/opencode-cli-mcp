# opencode-cli-mcp configuration
# Copy this file to .env and fill in your values.
# This file is bundled with the NSIS installer (NOT .env).

# opencode CLI HTTP API URL (opencode serve)
OPENCODE_SERVE_URL=http://127.0.0.1:4096

# Path to the opencode binary. Default: resolved via shutil.which()
# (covers npm-installed opencode.CMD shims).
# OPENCODE_BINARY=C:\path\to\opencode.exe

# Global opencode config file (config/*.json). Default: auto-detected.
# OPENCODE_GLOBAL_CONFIG=%USERPROFILE%\.config\opencode\opencode.json

# Transport convention for the MCP surface: stdio (default) or http.
# The unified backend (api.main) serves REST /api/* + MCP /mcp on one port.
MCP_TRANSPORT=stdio

# HTTP backend port. run_server.py prefers OPENCODE_CLI_MCP_PORT, then
# BACKEND_PORT (api/main.py's dev-mode env), then 10951.
OPENCODE_CLI_MCP_PORT=10951
# BACKEND_PORT=10951

# Optional auth for opencode serve. Set ONLY if serve is password-protected -
# the opencode desktop app sets OPENCODE_SERVER_PASSWORD itself, and leaving
# it in .env will break the unauthenticated default.
# OPENCODE_SERVER_USERNAME=opencode
# OPENCODE_SERVER_PASSWORD=

# Session depot: override the opencode SQLite DB location
# (default: ~/.local/share/opencode/opencode.db, resolved via XDG_DATA_HOME).
# OPENCODE_DB_PATH=%LOCALAPPDATA%\opencode\opencode.db
# XDG_DATA_HOME=D:\data\opencode

# Override the SQLite job store location
# OPENCODE_CLI_MCP_JOBS_DB=%LOCALAPPDATA%\opencode-cli-mcp\jobs.db

# Set 0 to skip Prefab card registration
# OPENCODE_CLI_MCP_PREFAB_APPS=1

# LanceDB RAG (semantic search over session transcripts; requires
# `uv sync --extra rag` for lancedb + fastembed + pyarrow)
# OPENCODE_CLI_MCP_RAG_ENABLED=1
# OPENCODE_CLI_MCP_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# OPENCODE_CLI_MCP_LANCE_DIR=%LOCALAPPDATA%\opencode-cli-mcp\lancedb
